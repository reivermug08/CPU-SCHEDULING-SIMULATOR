import tkinter as tk
from tkinter import messagebox, ttk

class CPUScheduler:
    def __init__(self):
        self.window = tk.Tk()
        self.window.title("CPU Scheduling Simulator")
        self.window.geometry("960x750")
        self.window.resizable(True, True)
        self.window.config(bg="#1e1e2f")

        self.process_entries  = []
        self.colors           = ["#6c5ce7","#00cec9","#fdcb6e","#ff7675",
                                  "#00b894","#e84393","#0984e3","#e17055"]
        self.current_schedule = []
        self.resize_timer     = None

        self.setup_ui()
        self.window.bind("<Configure>", self.on_resize)

    def _on_page_configure(self, event=None):
        self._canvas_scroll.configure(scrollregion=self._canvas_scroll.bbox("all"))

    def _on_canvas_configure(self, event):
        # Keep the inner page frame as wide as the canvas
        self._canvas_scroll.itemconfig(self._page_window, width=event.width)

