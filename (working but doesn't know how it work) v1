        self._outer.pack(fill="both", expand=True)

        self._vscroll = ttk.Scrollbar(self._outer, orient="vertical")
        self._vscroll.pack(side="right", fill="y")

        self._canvas_scroll = tk.Canvas(
            self._outer, bg="#1e1e2f", highlightthickness=0,
            yscrollcommand=self._vscroll.set
        )
        self._canvas_scroll.pack(side="left", fill="both", expand=True)
        self._vscroll.config(command=self._canvas_scroll.yview)

        self.page = tk.Frame(self._canvas_scroll, bg="#1e1e2f")
        self._page_window = self._canvas_scroll.create_window(
            (0, 0), window=self.page, anchor="n"
        )

        self.page.bind("<Configure>", self._on_page_configure)
        self._canvas_scroll.bind("<Configure>", self._on_canvas_configure)

        # Mouse-wheel scrolling — routed smartly in _on_mousewheel
        self.window.bind_all("<MouseWheel>", self._on_mousewheel)
        self.window.bind_all("<Button-4>",   self._on_mousewheel)
        self.window.bind_all("<Button-5>",   self._on_mousewheel)

        # ── 1. TITLE ─────────────────────────────────────────────────────────
        tk.Label(
            self.page,
            text="CPU Scheduling Simulator",
            font=("Verdana", 18, "bold"),
            bg="#1e1e2f", fg="white"
        ).pack(pady=10)

        # ── 2. TOP INPUT BAR ─────────────────────────────────────────────────
